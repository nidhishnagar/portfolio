# YesMadam MySQL Database Connection
# Copy this file to .env and fill in your actual credentials (keep .env gitignored)

# Tableau Database (Analytics/Reporting)
TABLEAU_DB_HOST=prodsqluseractivity.yesmadam.com
TABLEAU_DB_PORT=3306
TABLEAU_DB_USER=nidhish
TABLEAU_DB_PASSWORD=your_password_here
TABLEAU_DB_NAME=ysmdm_admin

# User Activity Database (Optional)
USERACTIVITY_DB_HOST=tableaudb.yesmadam.com
USERACTIVITY_DB_PORT=3306
USERACTIVITY_DB_USER=nidhish
USERACTIVITY_DB_PASSWORD=your_password_here
USERACTIVITY_DB_NAME=ysmdm_admin

# VPN (optional - if queries need VPN tunnel)
VPN_ENABLED=false
VPN_USERNAME=nidhish.nagar@yesmadam.in
VPN_PASSWORD=your_vpn_password_here
VPN_URL=https://secure.yesmadam.com/

# MCP Server config
MCP_PORT=3000
LOG_LEVEL=info
